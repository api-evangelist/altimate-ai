            "name": "Available Credits",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/sdk/available_credits",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Check if credits are available for the given dataset type.\n\nUses the same credit system as the VS Code extension.\n``verify_executions`` raises 402 if credits are exhausted."
        },
        {
          "info": {
            "name": "Count Credits",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/sdk/count_credits",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Register credit usage for a successful operation."
        },
        {
          "info": {
            "name": "Report Failure",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/sdk/failures",
            "body": {
              "type": "json",
