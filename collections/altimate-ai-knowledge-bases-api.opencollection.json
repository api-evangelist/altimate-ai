        {
          "info": {
            "name": "Fork Template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/knowledge_bases/fork-template",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new knowledge base from a template"
        },
        {
          "info": {
            "name": "Get Templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/knowledge_bases/templates",
