              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a knowledge base"
        },
        {
          "info": {
            "name": "Delete Kb",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.myaltimate.com/knowledge_bases/:kb_id",
            "params": [
              {
                "name": "kb_id",
                "value": "",
                "type": "path"
              }
            ],
