  "items": [
    {
      "info": {
        "name": "AI_PLAYGROUND",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "View Shared Session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/playground/share/shared/:share_id",
            "params": [
              {
                "name": "share_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "View a shared playground session.\n\nThis is the public endpoint for viewing shared content.\n- 'anyone' links: No authentication required\n- 'specific_people' links: User must be authenticated and in the allowed list"
        },
        {
          "info": {
            "name": "List Shares",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/playground/share",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List share links.\n\n- If session_id is provided, returns share links for that session\n- Otherwise, returns all share links created by the current user"
        },
        {
          "info": {
            "name": "Create Share",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/playground/share",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new share link for a playground session.\n\n- **session_id**: The session to share\n- **access_type**: 'anyone' (public) or 'specific_people' (restricted)\n- **expires_in_days**: Optional expiration (1-365 days)\n- **user_ids**: Required for 'specific_people' access type\n- **title**: Optional title for the share link"
        },
        {
          "info": {
            "name": "List Shares For Session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/playground/share/session/:session_id",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List share links for a specific session."
        },
        {
          "info": {
            "name": "Get Share",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/playground/share/:share_id",
