          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/playground/agents/production/remove",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove an agent from the production agents list (agent-names config.agents)."
        }
