              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List schedules.\n\n- If session_id is provided, returns schedules for that session\n- Otherwise, returns all schedules created by the current user"
        },
        {
          "info": {
            "name": "Create Schedule Endpoint",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/playground/schedules",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new scheduled report.\n\n- **name**: Name for this schedule\n- **session_id**: Session to report on\n- **content_scope**: 'last_answer' or 'full_chat'\n- **frequency**: 'daily', 'weekly', 'monthly', or 'custom'\n- **hour**: Hour to run (0-23 UTC)\n- **emails**: Recipients"
        },
