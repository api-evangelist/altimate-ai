        {
          "info": {
            "name": "Get Filter Options",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/alerts/metrics/filters/:filter_key/options",
            "params": [
              {
                "name": "filter_key",
                "value": "",
                "type": "path"
              },
              {
                "name": "metric_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search pattern (tags filter)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (tags filter)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size (tags filter)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
