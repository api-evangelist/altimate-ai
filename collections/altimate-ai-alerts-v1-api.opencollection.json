        {
          "info": {
            "name": "Dry Run",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/api/v1/alerts/dry-run",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Evaluate a rule config on-the-fly without persisting anything.\n\nAccepts the same JSON shape as RuleCreateRequest / the saved column,\nso the payload can be copy-pasted directly."
        },
        {
          "info": {
            "name": "Preview",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/api/v1/alerts/preview",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Preview what a metric config would produce (chart + markdown)."
        },
        {
          "info": {
            "name": "Test Notification",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/api/v1/alerts/notifications/test",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Send a test notification using a draft rule config.\n\nRuns the same evaluator + chart pipeline as a real alert against real\nClickHouse data, then dispatches via the chosen notifier (email / slack /\nwebhook). Hard-fails on validation or chart-generation errors;\nreturns 200 with `{ok: false, error}` for delivery failures.\n\nRate limited to 10 requests/minute per tenant."
        },
        {
          "info": {
            "name": "List Templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/alerts/templates",
            "params": [
              {
                "name": "platform",
                "value": "",
                "type": "query",
                "description": "Filter by platform: 'snowflake' or 'databricks'"
              },
              {
                "name": "tag",
                "value": "",
                "type": "query",
                "description": "Filter templates by tag, e.g. 'popular'"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Flat template library for the alert creation UI."
        },
        {
          "info": {
            "name": "Get Template",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/alerts/templates/:template_id",
            "params": [
              {
                "name": "template_id",
                "value": "",
