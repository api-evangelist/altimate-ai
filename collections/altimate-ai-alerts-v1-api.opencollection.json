          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/alerts/rules",
            "params": [
              {
                "name": "rule_type",
                "value": "",
                "type": "query",
                "description": "'alert' or 'report'"
              },
              {
                "name": "platform",
                "value": "",
                "type": "query",
                "description": "'snowflake' or 'databricks'"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "category",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Paginated list of alert/report rules."
        },
        {
          "info": {
            "name": "Create",
