  "items": [
    {
      "info": {
        "name": "EVALS",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Test Cases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/evals/test-cases",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List eval test cases filtered by tenant."
        },
        {
          "info": {
            "name": "Create Test Case",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/evals/test-cases",
