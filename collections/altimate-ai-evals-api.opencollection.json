        {
          "info": {
            "name": "Get Playground Agents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/evals/agents",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all production agents from Langfuse for evaluation playground.\n\nReturns a dictionary of agents with their details including:\n- name, description, version, all_versions, prompt, labels, tags\n\nAlso returns the list of available models for agent configuration."
        },
        {
          "info": {
            "name": "Get Playground Agent Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/evals/agents/:agent_name",
            "params": [
              {
                "name": "agent_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "include_prompt",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get detailed information for a specific agent from Langfuse.\n\nReturns complete agent details including:\n- agent_name, description, model, version, all_versions\n- prompt (if include_prompt=True)\n- labels, tags, config"
        },
        {
          "info": {
            "name": "Update Playground Agent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/evals/agents/:agent_name/update",
            "params": [
              {
                "name": "agent_name",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an agent's configuration in Langfuse.\n\nUpdates the agent's prompt and config (description, model, etc.).\nCreates a new version of the agent in Langfuse.\n\nReturns the updated agent details."
        },
        {
          "info": {
            "name": "Get Agent Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/evals/agents/:agent_name/versions",
            "params": [
              {
                "name": "agent_name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all versions of an agent from Langfuse.\n\nReturns a list of all versions with their metadata (description, model, labels, tags).\nVersions are sorted in descending order (newest first)."
        },
        {
          "info": {
            "name": "Get Agent Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/evals/agents/:agent_name/versions/:version",
            "params": [
              {
                "name": "agent_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a specific version of an agent from Langfuse.\n\nReturns the complete agent details for the specified version including the prompt."
        },
        {
          "info": {
            "name": "Get Available Models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/evals/models",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get list of all supported AI models for evaluation playground.\n\nReturns a list of models with their IDs, names, providers, and descriptions.\nModels include both OpenAI (GPT) and Anthropic (Claude) models."
        },
        {
          "info": {
            "name": "Run Batch Evaluation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/evals/evaluate",
            "params": [
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Run evaluations for multiple test cases with all selected agents and criteria.\n\nEach test case is evaluated with ALL selected agents available for use.\nThis is the main evaluation endpoint that accepts:\n- List of agents with full configuration (all agents are available for each test case)\n- List of test case IDs (reference to pool)\n- List of criteria with complete data\n\nReturns a job ID and status information."
        },
        {
          "info": {
            "name": "Get Job Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/evals/jobs/:job_id/status",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the current status of an evaluation job.\n\nReturns:\n- job_id: The job identifier\n- status: Current job status (submitted, running, completed, failed)\n- total: Total number of test cases\n- completed: Number of completed test cases\n- successful: Number of successful test cases\n- failed: Number of failed test cases\n- test_statuses: List of individual test case statuses\n- agents_count: Number of agents used\n- criteria_count: Number of criteria used"
        }
      ]
    }
  ],
  "bundled": true
}