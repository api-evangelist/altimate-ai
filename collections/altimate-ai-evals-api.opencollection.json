              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Run an evaluation for a test case.\nThis simulates the conversation by calling the /ask endpoint and evaluates responses."
        },
        {
          "info": {
            "name": "Batch Run Eval",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/evals/batch-run",
            "params": [
              {
