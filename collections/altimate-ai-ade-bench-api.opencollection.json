{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS ade-bench API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "ade-bench",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/ade-bench/runs",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Results per page"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset for pagination"
              },
              {
                "name": "agent",
                "value": "",
                "type": "query",
                "description": "Filter by agent name"
              },
              {
                "name": "model",
                "value": "",
                "type": "query",
                "description": "Filter by model name"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Filter runs after this date (ISO format)"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "Filter runs before this date (ISO format)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List benchmark runs with pagination and optional filters.\n\nReturns a paginated list of benchmark run metadata, sorted by start time (most recent first)."
        },
        {
          "info": {
            "name": "Get Run",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/ade-bench/runs/:run_id",
            "params": [
              {
                "name": "run_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get metadata for a specific benchmark run."
        },
        {
          "info": {
            "name": "Delete Run",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.myaltimate.com/api/ade-bench/runs/:run_id",
            "params": [
              {
                "name": "run_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a benchmark run and all its associated data."
        },
        {
          "info": {
            "name": "Get Run Results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/ade-bench/runs/:run_id/results",
            "params": [
              {
                "name": "run_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get full results for a specific benchmark run.\n\nIncludes all trial results and computed metrics like accuracy and pass@k."
        },
        {
          "info": {
            "name": "List Trials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/ade-bench/runs/:run_id/trials",
            "params": [
              {
                "name": "run_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all trials for a specific benchmark run.\n\nReturns summary information for each trial."
        },
        {
          "info": {
            "name": "Get Trial",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/ade-bench/runs/:run_id/trials/:trial_name",
            "params": [
              {
                "name": "run_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "trial_name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get detailed results for a specific trial."
        },
        {
          "info": {
            "name": "Get Filter Options",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/ade-bench/filters",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get available filter options for the runs list.\n\nReturns unique agents and models across all runs."
        },
        {
          "info": {
            "name": "Get Task Progress",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/ade-bench/progress",
            "params": [
              {
                "name": "run_ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of run IDs to include"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get cumulative task progress across selected runs.\n\nShows which tasks have been solved, test pass rates, and progress metrics.\nIf run_ids is provided, only those runs are considered. Otherwise, all runs are included."
        }
      ]
    }
  ],
  "bundled": true
}