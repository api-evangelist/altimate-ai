{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS Databricks Access Rules API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Databricks Access Rules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Databricks accounts/workspaces grantable in access rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/access-rules/options",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return the catalog of accounts/workspaces for the access-rule picker."
        }
      ]
    }
  ],
  "bundled": true
}