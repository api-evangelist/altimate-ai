{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS REGISTRY API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "REGISTRY",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Registry",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/registries/",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets all registries from db\n:param db: database session\n:param auth: auth token."
        },
        {
          "info": {
            "name": "Create Registry",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/registries/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new registry\n:param db: database session\n:param registry_creation_request: registry creation request\n:param auth: auth token. Also gets the user_id from the token\nreturn: RegistryCreationResponse."
        },
        {
          "info": {
            "name": "Get Registry By Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/registries/id/:registry_id",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets the registru by id\n:param registry: registry object fetched from db\n:param auth: auth token."
        },
        {
          "info": {
            "name": "Get Registry By Name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/registries/name/:registry_name",
            "params": [
              {
                "name": "registry_name",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets the registru by id\n:param registry_name: registry name\n:param db: database session\n:param auth: auth token."
        },
        {
          "info": {
            "name": "Update Registry",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.myaltimate.com/registries/:registry_id",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update the registry by the provided information\n:param db: database session\n:param registry: registry object fetched from db. Check if the registry exists\n:param registry_update_request: registry update request\n:param auth: auth token. Also gets the user_id from the token\n:param registry_id: registry id. This is the path param"
        },
        {
          "info": {
            "name": "Delete Registry",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.myaltimate.com/registries/:registry_id",
            "params": [
              {
                "name": "registry_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes registry. If already deleted, returns 404\ndb: Session = Depends(get_db) is a dependency injection which returns the db session with the tenant\nregistry_id: registry to delete\nregistry: registry object fetched from db which needs to be deleted\nauth=Depends(has_token) is a dependency injection which validates and returns the user_id"
        }
      ]
    }
  ],
  "bundled": true
}