{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS WORKLOAD API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "WORKLOAD",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Workload Attributes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/workload/attributes",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get available workload attributes for grouping and filtering.\n\nReturns default attributes (project_id, app_id) plus any custom tags\nconfigured in the workload settings."
        },
        {
          "info": {
            "name": "Get Workload Attribute Values",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/workload/attributes/:attribute_key/values",
            "params": [
              {
                "name": "attribute_key",
                "value": "",
                "type": "path"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "workflow_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-indexed)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Items per page"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search string to filter values"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get distinct values for a specific workload attribute with pagination.\n\nThis endpoint extracts distinct values from the query_tag column in ClickHouse\nbased on the specified attribute_key. Used for populating filter dropdowns\nwhen a workload attribute is selected for grouping."
        }
      ]
    }
  ],
  "bundled": true
}