{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS Databricks Savings API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Databricks Savings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get autonomous savings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/savings/autonomous",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get autonomous savings data.\n\nNote: For Databricks, autonomous savings is always zero as there are\nno automated optimization agents."
        },
        {
          "info": {
            "name": "Get assisted savings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/savings/assisted",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get assisted savings from opportunities.\n\nShows potential savings from implementing identified opportunities."
        },
        {
          "info": {
            "name": "Get tracked assisted savings from PostgreSQL",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/savings/assisted/tracked",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID (maps to instance_id)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get tracked assisted savings from PostgreSQL opportunity_saving_attribution table.\n\nThis endpoint provides actual realized savings from implemented opportunities,\nfollowing the same pattern as Snowflake's assisted savings calculation."
        },
        {
          "info": {
            "name": "Get overall savings summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/savings/overall",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get overall savings summary.\n\nCombines autonomous (always 0 for Databricks) and assisted savings."
        },
        {
          "info": {
            "name": "Get overall savings estimate with projections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/savings/overall/estimate",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "savings_period",
                "value": "",
                "type": "query",
                "description": "Projection period: thisYear or next1Year"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get overall savings estimate with future projections.\n\nProjects potential savings based on current opportunity analysis."
        }
      ]
    }
  ],
  "bundled": true
}