{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS Databricks Insights API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Databricks Insights",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Databricks environment overview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/insights/overview",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date for metrics"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date for metrics"
              },
              {
                "name": "days",
                "value": "",
                "type": "query",
                "description": "Days for activity metrics"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get complete overview of Databricks environment.\n\nReturns aggregated insights including:\n- Compute resources (clusters, warehouses)\n- Job health (runs, failures)\n- Query health (counts, performance)\n- Cost summary and top drivers\n- Utilization insights"
        },
        {
          "info": {
            "name": "Get activity by workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/insights/workspace-activity",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "days",
                "value": "",
                "type": "query",
                "description": "Days to analyze"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get activity summary by workspace."
        }
      ]
    }
  ],
  "bundled": true
}