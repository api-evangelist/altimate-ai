            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetches a contract by id. Only fetches if it exists in the provided registry\nparam auth: The authorization token for the request.\nparam contract: The fetched contract object\nreturn: A dictionary containing the contract"
