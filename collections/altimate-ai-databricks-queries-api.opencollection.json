        {
          "info": {
            "name": "Search statement IDs for the Query ID filter dropdown",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/queries/filters/statement-ids",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "prefix",
                "value": "",
                "type": "query",
                "description": "Substring to match statement IDs against. Searches kick in once the typed text reaches 2 characters; shorter inputs return an empty list without scanning ClickHouse so the dropdown's open-with-empty-prefix probe is free."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-indexed)"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of IDs per page"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Server-side search for statement IDs — backs the Query ID filter dropdown.\n\nMatches statement IDs by substring so the dropdown never loads the full\nID list; results are paginated."
        },
        {
          "info": {
            "name": "Get query summary metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/queries/summary",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by single workspace ID (legacy URL pre-selection)"
              },
              {
                "name": "workspace_ids",
                "value": "",
                "type": "query",
                "description": "Filter by one or more workspace IDs (column multi-select)"
              },
              {
                "name": "warehouse_id",
                "value": "",
                "type": "query",
                "description": "Filter by one or more warehouse IDs (legacy column multi-select). Prefer ``compute_id`` for new FE bindings — it covers warehouse + cluster + pipeline in one parameter. Entries here are merged with any ``compute_id`` warehouse selections before the BE applies the filter."
              },
              {
                "name": "compute_id",
                "value": "",
                "type": "query",
                "description": "Unified Compute filter: one or more ``{kind}:{id}`` selections from the dropdown, where ``kind`` is ``warehouse``, ``cluster``, or ``pipeline``. A mixed selection is ORed (rows of any selected kind match). Entries with an unknown ``kind`` or empty id are silently skipped so this stays forward-compatible if the FE adopts a new kind ahead of the BE."
              },
              {
                "name": "insights",
                "value": "",
                "type": "query",
                "description": "Filter by insight tags (slow_query, disk_spill, full_table_scan, failed)"
              },
              {
                "name": "statement_type",
                "value": "",
                "type": "query",
                "description": "Filter by statement type"
              },
              {
                "name": "user_name",
                "value": "",
                "type": "query",
                "description": "Filter by one or more user names. Single-value calls (e.g. the User-list drilldown URL ``?user_name=alice``) continue to work — FastAPI parses the single value as a one-element list and the BE applies the matching IN-clause filter. Multi-select dropdowns send ``?user_name=alice&user_name=bob``."
              },
              {
                "name": "statement_ids",
                "value": "",
                "type": "query",
                "description": "Filter by one or more exact query (statement) IDs"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get summary metrics for queries.\n\nAccepts the same filter set as ``GET /queries/unified`` so the summary\ncards reflect the exact rows the queries table renders for a given\nfilter selection."
        },
