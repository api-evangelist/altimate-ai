      },
      "items": [
        {
          "info": {
            "name": "Predict Query Time",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/predict/query-time-estimate",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Predict query execution time with confidence intervals.\n\nReturns median prediction with 80% confidence interval.\nUses model_with_historical for repeated queries or model_without_historical for new queries."
        }
      ]
    }
  ],
  "bundled": true
