          "name": "Get Data Availability",
          "request": {
            "name": "Get Data Availability",
            "description": {
              "content": "Retrieves data availability information for a specified page.\n\nReturns the maximum available data date based on the minimum of all required\ndataset types for the given page.\n\nArgs:\n    page: The page identifier for data availability lookup\n\nReturns:\n    dict: Contains max_date field with the earliest completion date among all required datasets\n\nRaises:\n    HTTPException: 400 if page is not supported, 404 if no data found",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data_availability",
                ":page"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "page",
                  "description": "(Required) "
                }
              ]
