{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS PUBLIC_SNIPPETS API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "PUBLIC_SNIPPETS",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Snippets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/public/snippets",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-indexed)"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Items per page"
              },
              {
                "name": "database_type",
                "value": "",
                "type": "query",
                "description": "Filter by database type (e.g., clickhouse, postgres)"
              },
              {
                "name": "tags",
                "value": "",
                "type": "query",
                "description": "Filter by tags (multiple allowed)"
              },
              {
                "name": "snippet_type",
                "value": "",
                "type": "query",
                "description": "Filter by type (data_definition or sql_example)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all code snippets with pagination and filtering.\n\nThis endpoint is for service users (PUBLIC_TENANT) to retrieve\ncode snippets stored in Weaviate."
        },
        {
          "info": {
            "name": "Create Snippet Endpoint",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/public/snippets",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new snippet in Weaviate.\n\nThis endpoint creates a new snippet in either the DataDefinition\nor SqlExamples collection based on the type field."
        },
        {
          "info": {
            "name": "Get Snippets Filters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/public/snippets/filters",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get available filter options for snippets.\n\nReturns the unique database types and tags available for filtering."
        },
        {
          "info": {
            "name": "Execute Snippet Endpoint",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/public/snippets/execute",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Execute a SQL snippet against a tenant's datastore.\n\nThe target tenant is specified in the request body, allowing\nPUBLIC_TENANT users to execute against any company's datastore."
        },
        {
          "info": {
            "name": "Get Snippet",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/public/snippets/:snippet_id",
            "params": [
              {
                "name": "snippet_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a single snippet by its Weaviate UUID.\n\nThis endpoint retrieves a specific snippet from either the\nDataDefinition or SqlExamples collection."
        },
        {
          "info": {
            "name": "Update Snippet Endpoint",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.myaltimate.com/public/snippets/:snippet_id",
            "params": [
              {
                "name": "snippet_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an existing snippet in Weaviate.\n\nThis endpoint updates a specific snippet's properties.\nOnly non-null fields in the request will be updated."
        },
        {
          "info": {
            "name": "Delete Snippet Endpoint",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.myaltimate.com/public/snippets/:snippet_id",
            "params": [
              {
                "name": "snippet_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a snippet from Weaviate.\n\nThis endpoint deletes a specific snippet from either the\nDataDefinition or SqlExamples collection."
        }
      ]
    }
  ],
  "bundled": true
}