{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS Chat API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Chat",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Chat Completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/agents/v1/chat/completions",
            "headers": [
              {
                "name": "x-session-id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a chat completion (OpenAI-compatible).\n\nUses litellm with provider fallback: Azure GPT-5.5 → Anthropic Sonnet 4.6.\nThe model in the request is ignored — provider selection is automatic."
        }
      ]
    }
  ],
  "bundled": true
}