{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS Users API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user activity and creation report with insights",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/business_intelligence/users",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort_by",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "views_period",
                "value": "",
                "type": "query",
                "description": "Time period for views (30, 90, or 180 days)"
              },
              {
                "name": "user",
                "value": "",
                "type": "query"
              },
              {
                "name": "license_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "insights",
                "value": "",
                "type": "query"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "instance_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "opportunity_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get user activity and creation patterns with insights.\nReturns paginated users with filtering and sorting capabilities.\n\nAvailable sorting fields:\n- email: User email address\n- views: User views for specified time period\n- dashboards_created: Total dashboards created\n- workbooks_created: Total workbooks created\n- views_received_30d: Views received on user's dashboards (30d)\n- last_activity: Last activity date (only sorting, no filtering)\n\nFiltering options:\n- views_period: Time period for views "
        },
        {
          "info": {
            "name": "Get user summary statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/business_intelligence/users/summary",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get summary statistics for user report including:\n- Total Users: All unique users (viewers + owners)\n- Active Users (30d): Users who viewed dashboards in last 30 days\n- Dashboard Creators: Users who have created dashboards"
        },
        {
          "info": {
            "name": "Get BI User report filters",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/business_intelligence/users/filters",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get available filter options for user reports.\n\nReturns available values for:\n- user: List of user emails\n- license_type: List of license types\n- insights: List of available user insight types\n- instance_name: List of instance names\n- opportunity_name: List of opportunity names"
        },
        {
          "info": {
            "name": "Get user by user_rk",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/business_intelligence/users/get_by_rk",
            "params": [
              {
                "name": "user_rk",
                "value": "",
                "type": "query",
                "description": "User RK to retrieve"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a specific user by their user_rk.\nReturns user activity and creation patterns with insights."
        },
        {
          "info": {
            "name": "Download all users data as CSV",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/business_intelligence/users/download",
            "params": [
              {
                "name": "sort_by",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "views_period",
                "value": "",
                "type": "query",
                "description": "Time period for views (30, 90, or 180 days)"
              },
              {
                "name": "user",
                "value": "",
                "type": "query"
              },
              {
                "name": "license_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "insights",
                "value": "",
                "type": "query"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query"
              },
              {
                "name": "instance_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "opportunity_name",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Download all users data as CSV.\nAccepts the same filtering parameters as the /users endpoint.\nEach insight type becomes a separate column with Yes/No values."
        }
      ]
    }
  ],
  "bundled": true
}