{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS langfuse API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "langfuse",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Clickhouse Queries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/langfuse/queries",
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date in ISO format"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date in ISO format"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Results per page"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get ClickHouse queries from Langfuse observations.\n\nFetches observations with name 'mcp__altimate__clickhouse_query' from Langfuse\nwithin the specified date range. Returns paginated results."
        },
        {
          "info": {
            "name": "Get Prompts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/langfuse/prompts",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter by prompt name"
              },
              {
                "name": "label",
                "value": "",
                "type": "query",
                "description": "Filter by label"
              },
              {
                "name": "tag",
                "value": "",
                "type": "query",
                "description": "Filter by tag"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get prompts from Langfuse.\n\nFetches prompt configurations from Langfuse, optionally filtered by name, label, or tag."
        }
      ]
    }
  ],
  "bundled": true
}