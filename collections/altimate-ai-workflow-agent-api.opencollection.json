{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS WORKFLOW_AGENT API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "WORKFLOW_AGENT",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Post Heartbeat",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/api/v1/workflow/agent/heartbeat",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Agent posts health ping. Returns pending commands."
        },
        {
          "info": {
            "name": "Acknowledge Command",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/api/v1/workflow/agent/commands/:command_id/ack",
            "params": [
              {
                "name": "command_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Agent reports command execution result."
        },
        {
          "info": {
            "name": "Pull Config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/workflow/agent/config/:namespace",
            "params": [
              {
                "name": "namespace",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Agent pulls all configs for a namespace."
        },
        {
          "info": {
            "name": "Pull All Configs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/workflow/agent/config",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Agent pulls all configs across all namespaces."
        },
        {
          "info": {
            "name": "Pull Pending Commands",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/workflow/agent/commands",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Agent pulls pending commands."
        },
        {
          "info": {
            "name": "Report Session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/api/v1/workflow/agent/sessions",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Agent reports a new or updated session."
        },
        {
          "info": {
            "name": "Report Message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/api/v1/workflow/agent/messages",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Agent appends a message to a session's conversation log.\n\nsession_id can be either a workflow_sessions UUID or an openclaw_session_id.\nIf the session doesn't exist yet, auto-create it from the openclaw_session_id."
        },
        {
          "info": {
            "name": "Sync Cron Jobs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/api/v1/workflow/agent/cron/sync",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Agent syncs its cron job state."
        }
      ]
    }
  ],
  "bundled": true
}