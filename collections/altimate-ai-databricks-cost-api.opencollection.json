        },
        {
          "info": {
            "name": "Get Databricks cost trends by product over time",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/cost/trends/by-product",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date for the period"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date for the period"
              },
              {
                "name": "granularity",
                "value": "",
                "type": "query",
                "description": "Time granularity: 'day', 'week', or 'month'"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "category",
                "value": "",
                "type": "query",
                "description": "Which UI category the chart is for. Drives both the product filter and the per-row segment label. ``total`` returns the 5 spec-group stack (Clusters / SQL Warehouse / AI/ML / Lakehouse / Platform). ``sql_warehouse`` returns Classic / Pro / Serverless. Other values return the products in that spec group."
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get cost trends over time, sliced for a UI category.\n\nReturns time series data with DBU consumption and estimated cost per\nperiod, with each row labelled by the category's chosen segment. The\n``products`` array in the response is the canonical legend for the\ncategory (in display order, including segments with no data) so the FE\nlegend stays stable across date ranges."
        },
