{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS EXTERNAL API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "EXTERNAL",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Stripe Payment Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/external/stripe/webhook",
            "headers": [
              {
                "name": "stripe-signature",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Stripe Payment Webhook"
        },
        {
          "info": {
            "name": "Calendly Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/external/calendly/webhook",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Handle Calendly invitee.created webhooks and grant feedback-call credits."
        }
      ]
    }
  ],
  "bundled": true
}