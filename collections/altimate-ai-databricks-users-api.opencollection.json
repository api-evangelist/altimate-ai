{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS Databricks Users API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Databricks Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get filter options for users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/users/filters",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "prefix",
                "value": "",
                "type": "query",
                "description": "Search prefix for name filters"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Workspace ID to filter by"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get distinct filter values for user filtering."
        },
        {
          "info": {
            "name": "Get all users with query statistics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/users",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date (inclusive) for query / cost statistics. Defaults to 30 days before `end_date`."
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date (inclusive). Defaults to today."
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-indexed)"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Items per page"
              },
              {
                "name": "sortAttribute",
                "value": "",
                "type": "query",
                "description": "Sort column name. Valid columns: user_name, total_queries, successful_queries, failed_queries, avg_duration_ms, max_duration_ms, total_duration_ms, total_read_bytes, total_spilled_bytes, last_query_time, total_dbus, total_cost (cost columns sorted with zeros/nulls last)."
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query",
                "description": "Sort direction: 'asc' or 'desc'"
              },
              {
                "name": "user_names",
                "value": "",
                "type": "query",
                "description": "Filter by user names"
              },
              {
                "name": "user_types",
                "value": "",
                "type": "query",
                "description": "Filter by identity type(s). Repeat to combine: 'USER', 'SERVICE_PRINCIPAL'"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all users with query statistics."
        },
        {
          "info": {
            "name": "Get top users by query count",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/users/top/queries",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "days",
                "value": "",
                "type": "query",
                "description": "Number of days for statistics"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of users"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get top users by query count."
        },
        {
          "info": {
            "name": "Get top users by data read",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/users/top/data-read",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "days",
                "value": "",
                "type": "query",
                "description": "Number of days for statistics"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of users"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get top users by data read."
        },
        {
          "info": {
            "name": "Get service-principal classification config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/users/service-principal-config",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return the tenant's prefix/regex patterns used to classify service principals.\n\nThe built-in application-id UUID rule is always applied in addition to\nthese. Returns empty lists when no config has been saved."
        },
        {
          "info": {
            "name": "Upsert service-principal classification config",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.myaltimate.com/api/v1/databricks/users/service-principal-config",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Save the prefix/regex patterns used to classify Databricks service principals.\n\nReplaces any existing config. Invalid regexes are rejected at validation time."
        },
        {
          "info": {
            "name": "Get user details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/users/:user_name",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "user_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "days",
                "value": "",
                "type": "query",
                "description": "Number of days for statistics"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get detailed information for a specific user."
        },
        {
          "info": {
            "name": "Get user query trends",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/users/:user_name/trends",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "user_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "granularity",
                "value": "",
                "type": "query",
                "description": "Time granularity: 'day', 'week', or 'month'"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get query trends for a specific user."
        },
        {
          "info": {
            "name": "Get user statement breakdown",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/api/v1/databricks/users/:user_name/statement-breakdown",
            "headers": [
              {
                "name": "x-tenant",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "user_name",
                "value": "",
                "type": "path"
              },
              {
                "name": "days",
                "value": "",
                "type": "query",
                "description": "Number of days for statistics"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get statement type breakdown for a specific user."
        }
      ]
    }
  ],
  "bundled": true
}