{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS GLOBAL_CONFIG API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "GLOBAL_CONFIG",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Global Config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/global_config/",
            "params": [
              {
                "name": "config_type",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get global configuration for query tags or cost attribution"
        },
        {
          "info": {
            "name": "Add Query Tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/global_config/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add a new query tag to global configuration"
        },
        {
          "info": {
            "name": "Upsert Cost Attribution",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/global_config/cost-attribution",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Upsert cost attribution global configuration"
        },
        {
          "info": {
            "name": "Get Email Domain Allowlist",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/global_config/recipient-email-domain-allowlist",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the per-tenant recipient email-domain allowlist with attribution and\nstatus. Owner only."
        },
        {
          "info": {
            "name": "Add Email Domain",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/global_config/recipient-email-domain-allowlist",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add a domain to the allowlist. Stamps the current user and time, status\nactive. Owner only. Invalid or duplicate domains are rejected."
        },
        {
          "info": {
            "name": "Update Email Domain Status",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.myaltimate.com/global_config/recipient-email-domain-allowlist",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a domain's status (active / paused). Owner only. The\nstatus value is validated by the request schema."
        },
        {
          "info": {
            "name": "Delete Email Domain",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.myaltimate.com/global_config/recipient-email-domain-allowlist/:domain",
            "params": [
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove a domain from the allowlist. Owner only."
        }
      ]
    }
  ],
  "bundled": true
}