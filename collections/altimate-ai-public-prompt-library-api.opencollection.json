{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS PUBLIC_PROMPT_LIBRARY API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "PUBLIC_PROMPT_LIBRARY",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Public Prompt",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/public/prompts",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a public prompt (service user only).\nThis endpoint is specifically for service users to create public prompts."
        },
        {
          "info": {
            "name": "Delete Public Prompt",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.myaltimate.com/public/prompts/:prompt_id",
            "params": [
              {
                "name": "prompt_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a public prompt (service user only).\nThis endpoint is specifically for service users to delete public prompts."
        }
      ]
    }
  ],
  "bundled": true
}