{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fast ACCOUNT_COSTS VIOLATIONS API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "VIOLATIONS",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/violations/summary",
            "params": [
              {
                "name": "table_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets all violations.\n- table_id: search parameter"
        },
        {
          "info": {
            "name": "Get All",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/violations/",
            "params": [
              {
                "name": "table_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "timestamp",
                "value": "",
                "type": "query"
              },
              {
                "name": "levels",
                "value": "",
                "type": "query"
              },
              {
                "name": "contract_ids",
                "value": "",
                "type": "query"
              },
              {
                "name": "event_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortColumn",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "Page size"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets all violations.\n- table_id: search parameter\n- timestamp: '24h', '1w'\n- levels: search level(can be multiple)\n- contract_ids: search contract(can be multiple)\n- sortColumn: 'incident_id', 'policy_name'\n- sortOrder: 'asc', 'desc'"
        },
        {
          "info": {
            "name": "Get One",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.myaltimate.com/violations/id/:violation_id",
            "params": [
              {
                "name": "violation_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Gets the violation by id."
        },
        {
          "info": {
            "name": "Snooze Validation For Violation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.myaltimate.com/violations/:violation_id/snooze/:snoozed_till",
            "params": [
              {
                "name": "violation_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "snoozed_till",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "- Finds the term by the violation_id\n- Updates the status, snoozed_till param for the term in the db\n- snoozed_till can have only two values: '24h', '1w'"
        }
      ]
    }
  ],
  "bundled": true
}