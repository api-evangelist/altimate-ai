              }
            ],
            "params": [
              {
                "name": "resource_type",
                "value": "",
                "type": "query",
                "description": "Type of resource (cluster, warehouse, job, query, user)"
              },
              {
                "name": "resource_id",
                "value": "",
                "type": "query",
                "description": "Optional resource ID for context"
              },
              {
                "name": "resource_name",
                "value": "",
                "type": "query",
                "description": "Optional resource name for context"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Optional workspace ID for context"
              }
