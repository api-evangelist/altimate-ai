                "description": "Start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace ID"
              },
              {
                "name": "navigationSource",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get the SQL warehouses list page's \"Total Savings\" cards — Realised\nSavings, Estimated Annual Savings, and Total Opportunities.\n\nDeclared before `/{warehouse_id}` so FastAPI's declaration-order route\nmatching doesn't swallow this path as a warehouse_id lookup.\n\nNote: unlike the warehouses list, this aggregate only supports a single\n``workspace_id`` — ``get_warehouse_savings_totals_by_type`` (the\nunderlying repo method, shared with ``DatabricksSavingsService``'s\nother overall-savings endpoints) t"
        },
